# 跨编辑器一致性：缩进、行尾、尾随空白、最终换行。
# 与 scripts/hygiene.sh 的检查保持一致（LF + 最终换行 + 无尾随空白）。
root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space

[*.rs]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,html}]
indent_size = 2

[*.{sh,hooks,test.sh}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[justfile]
indent_style = space
indent_size = 4

[Containerfile]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
