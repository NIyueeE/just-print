# 复制为 /etc/just-print/just-print.env（与 quadlet 示例中的 EnvironmentFile
# 路径对应），并设为仅 root / 运行用户可读（chmod 600）。
#
# 完整部署说明与环境变量默认值见 docs/deployment.md。
#
# 只有 JUST_PRINT_TOKEN 必填；其余变量都有合理默认值，按需取消注释即可。
# EnvironmentFile 的内容按字面读取（systemd 不做 % 说明符展开，也不做 $ 展开），
# 因此令牌里的特殊字符不会被改写——这也是不要把令牌写进 Environment= 的原因。
#
# 生成强令牌：openssl rand -hex 32
# 留空时服务拒绝启动（fail-closed）。
JUST_PRINT_TOKEN=

# ---- 可选：按需覆盖的默认行为 ----
# 关闭 USB 打印机自动建队列（默认 1 = 开启）。
# JUST_PRINT_AUTO_USB=0
# 启用 mDNS / Avahi 并自动发现局域网内的 IPP Everywhere 打印机（默认 0）。
# JUST_PRINT_DISCOVER_IPP=1
# 添加 CUPS-PDF 调试打印机，便于无真实打印机时验证（默认 0）。
# JUST_PRINT_CUPS_PDF=1
# 固定 USB 队列使用的 PPD；留空则按 IEEE 1284 device-id 匹配（内置 HPLIP PCL
# 驱动），匹配不到时用通用 PCL。通用 PCL6 / PCL 见容器内 `lpinfo -m`。
# JUST_PRINT_USB_PPD=lsb/usr/cupsfilters/pxlmono.ppd
# USB 队列的额外 PPD 选项（逗号或空格分隔的 key=value），用于声明硬件事实；
# 例如声明双面器：通用 PCL6 PPD 用 OptionDuplex=True，sample 通用 PCL 用 Option1=True。
# JUST_PRINT_USB_OPTIONS=OptionDuplex=True

# ---- 可选：调优（默认值见 docs/deployment.md，一般无需设置）----
# 单文件上传上限（字节，默认 64 MiB）
# JUST_PRINT_MAX_UPLOAD_BYTES=67108864
# 并发上传 / 并发转换上限
# JUST_PRINT_UPLOAD_SLOTS=4
# JUST_PRINT_CONVERSION_SLOTS=2
# 转换超时、临时文件 TTL、清理周期（秒）
# JUST_PRINT_CONVERSION_TIMEOUT_SECS=120
# JUST_PRINT_TEMP_TTL_SECS=1800
# JUST_PRINT_CLEANUP_INTERVAL_SECS=60
# IPP 超时、打印机/任务缓存、幂等键保留、请求超时（秒）
# JUST_PRINT_IPP_TIMEOUT_SECS=15
# JUST_PRINT_PRINTER_CACHE_SECS=10
# JUST_PRINT_JOB_CACHE_SECS=2
# JUST_PRINT_IDEMPOTENCY_TTL_SECS=600
# JUST_PRINT_REQUEST_TIMEOUT_SECS=300
# 日志级别（如 just_print=debug）
# RUST_LOG=info
# 以下一般无需修改（镜像内已设为默认值）：
# JUST_PRINT_ADDR=0.0.0.0:8080
# JUST_PRINT_WEB_DIR=/usr/share/just-print/web
# JUST_PRINT_CUPS_URI=http://127.0.0.1:631
