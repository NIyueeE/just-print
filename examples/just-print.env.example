# 复制为 /etc/just-print/just-print.env（与 quadlet 示例中的
# EnvironmentFile 路径对应），并设为仅 root 可读。
# 完整部署说明见 docs/deployment.md。
#
# 建议使用 32 字节以上的随机值：openssl rand -hex 32
# 留空时服务拒绝启动（fail-closed）；部署前必须填入随机令牌。
JUST_PRINT_TOKEN=

# 后端监听地址；容器内直接对外监听，TLS 由云网关 / 反向代理终结。
JUST_PRINT_ADDR=0.0.0.0:8080

# 前端静态文件目录；镜像内已内置，一般无需修改。
JUST_PRINT_WEB_DIR=/usr/share/just-print/web

# 容器内 CUPS 服务地址；一般无需修改。
JUST_PRINT_CUPS_URI=http://127.0.0.1:631

# 无真实打印机调试：设为 1 时入口脚本自动添加 CUPS-PDF 调试打印机。
JUST_PRINT_CUPS_PDF=0

# 设为 1 时启用 mDNS / Avahi，并自动发现局域网内的 IPP Everywhere 打印机。
JUST_PRINT_DISCOVER_IPP=0

# 自动发现并添加 USB 打印机队列（默认 1；不需要时设为 0）。
JUST_PRINT_AUTO_USB=1

# 可选：固定自动添加 USB 打印机使用的 PPD；留空按型号匹配（镜像内置 HPLIP
# PCL 驱动），找不到才用通用 PCL。
JUST_PRINT_USB_PPD=

# 可选：USB 队列的额外 PPD 选项（逗号或空格分隔的 key=value），用来声明硬件事实。
# 例如打开双面器：通用 PCL PPD 用 Option1=True，HPLIP PPD 用 OptionDuplex=True。
# 说明见 docs/deployment.md「USB 打印机与 PPD 选项」。
# JUST_PRINT_USB_OPTIONS=Option1=True

# ---- 可选调优（默认值见 docs/deployment.md，一般无需设置）----
# 单文件上传上限（字节，默认 64 MiB）
# JUST_PRINT_MAX_UPLOAD_BYTES=67108864
# 并发上传 / 并发转换上限
# JUST_PRINT_UPLOAD_SLOTS=4
# JUST_PRINT_CONVERSION_SLOTS=2
# 转换超时、临时文件 TTL、清理周期（秒）
# JUST_PRINT_CONVERSION_TIMEOUT_SECS=120
# JUST_PRINT_TEMP_TTL_SECS=1800
# JUST_PRINT_CLEANUP_INTERVAL_SECS=60
# IPP 超时、打印机/任务缓存、幂等键保留、请求超时（秒）
# JUST_PRINT_IPP_TIMEOUT_SECS=15
# JUST_PRINT_PRINTER_CACHE_SECS=10
# JUST_PRINT_JOB_CACHE_SECS=2
# JUST_PRINT_IDEMPOTENCY_TTL_SECS=600
# JUST_PRINT_REQUEST_TIMEOUT_SECS=300
# 日志级别（如 just_print=debug）
# RUST_LOG=info
