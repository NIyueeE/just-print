# 复制为 /etc/just-print/just-print.env（与 quadlet 示例中的
# EnvironmentFile 路径对应），并设为仅 root 可读。
#
# 建议使用 32 字节以上的随机值：openssl rand -hex 32
# 留空时服务拒绝启动（fail-closed）；部署前必须填入随机令牌。
JUST_PRINT_TOKEN=

# 容器内 CUPS 服务地址；一般无需修改。
JUST_PRINT_CUPS_URI=http://127.0.0.1:631

# 无真实打印机调试：设为 1 时入口脚本自动添加 CUPS-PDF 调试打印机。
JUST_PRINT_CUPS_PDF=0

# 设为 1 时启用 mDNS / Avahi，并自动发现局域网内的 IPP Everywhere 打印机。
JUST_PRINT_DISCOVER_IPP=0
