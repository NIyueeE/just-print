# systemd Quadlet 示例（Podman >= 4.4）。
# 完整部署说明见 docs/deployment.md。
#
# 部署步骤：
#   sudo mkdir -p /etc/containers/systemd /etc/just-print
#   sudo cp examples/just-print.env.example /etc/just-print/just-print.env
#   sudo chmod 600 /etc/just-print/just-print.env
#   sudo cp examples/just-print.container /etc/containers/systemd/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now just-print.service
#
# 镜像直接从 GitHub Container Registry 拉取。

[Unit]
Description=Just Print service
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/niyueee/just-print:latest
ContainerName=just-print
PublishPort=8080:8080
Environment=JUST_PRINT_ADDR=0.0.0.0:8080
Environment=JUST_PRINT_WEB_DIR=/usr/share/just-print/web
Environment=JUST_PRINT_CUPS_URI=http://127.0.0.1:631
# 自动发现并添加 USB 打印机队列（默认开启；设为 0 关闭）。
Environment=JUST_PRINT_AUTO_USB=1
# 可选：固定自动添加 USB 打印机使用的 PPD；留空按型号匹配，找不到用通用 PCL。
# Environment=JUST_PRINT_USB_PPD=drv:///sample.drv/generpcl.ppd
EnvironmentFile=/etc/just-print/just-print.env
Tmpfs=/tmp
# 可选：持久化 CUPS spool 与 cups-pdf 输出。
# Volume=just-print-cups:/var/spool/cups
# Volume=just-print-cups-pdf:/var/spool/cups-pdf
# 若宿主机有 USB 打印机，取消注释并映射 CUPS usb 后端所需的设备目录：
# AddDevice=/dev/bus/usb:/dev/bus/usb
# AddDevice=/dev/usb:/dev/usb
# 需要更小权限时也可只映射具体节点，例如 AddDevice=/dev/usb/lp0:/dev/usb/lp0
AutoUpdate=registry
Pull=newer

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
